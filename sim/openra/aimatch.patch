+			Console.WriteLine($"AIMATCH start map={world.Map.Title} players={string.Join(",", world.Players.Where(p => p.Playable).Select(p => $"{p.PlayerName}:{p.Faction.InternalName}:{p.BotType}"))}");
+			world.GameOver += () =>
+			{
+				var result = string.Join(",", world.Players.Where(p => p.Playable).Select(p => $"{p.PlayerName}:{p.WinState}"));
+				Console.WriteLine($"AIMATCH end ticks={world.WorldTick} wall_s={(DateTime.UtcNow - started).TotalSeconds:F0} result={result}");
+				Exit();
+			};
+		}
