+
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Grpc.Core;
+using RLProto = OpenRA.Mods.Common.RL;
+
+namespace OpenRA.Mods.Common.Traits
+{
+	/// <summary>
+	/// friendly-fighter sim: virtual time. With RL_LOCKSTEP=1 a headless game no longer runs on the
+	/// wall clock: it runs exactly the ticks each Step RPC asks for, as fast as the CPU allows, and
+	/// returns the views those ticks produced. The caller owns the clock.
+	///
+	/// Two ways to host it: a single game started with Launch.Map (its local server, the game loop
+	/// hands its ticks to Drive), or multi-session mode (Launch.MultiSession: CreateSession makes a
+	/// world on an EchoConnection, no network; each Step runs that world's ticks on its own thread).
+	/// </summary>
+	public static class RLLockstep
+	{
+		public static readonly bool Enabled = Environment.GetEnvironmentVariable("RL_LOCKSTEP") == "1";
+
+		sealed class Job
+		{
+			public int Until;
+			public readonly List<RLProto.PlayerAction> Actions = new();
+			public readonly List<RLProto.PlayerObservation> Observations = new();
+			public readonly TaskCompletionSource<RLProto.StepReply> Done = new(TaskCreationOptions.RunContinuationsAsynchronously);
+		}
+
+		static readonly BlockingCollection<Job> Jobs = new();
+		[ThreadStatic]
+		static Job current;
+		static World world;
+
+		/// <summary>Called by each bridge when it activates: from then on the game loop runs our ticks only.</summary>
+		internal static void Install(World w)
+		{
+			if (ExternalBotBridge.MultiSessionMode)
+				return;
+
+			world = w;
+			Game.LockstepDriver = Drive;
+		}
+
+		/// <summary>Game thread: run the next job, if one comes within a moment.</summary>
+		static void Drive(Action tick)
+		{
+			if (!Jobs.TryTake(out var job, 20))
+				return;
+
+			current = job;
+			try
+			{
+				foreach (var bridge in ExternalBotBridge.Sessions.Values)
+					if (bridge.World == world && bridge.IsEnabled && !bridge.AgentConnected)
+						bridge.OnAgentConnected();
+
+				foreach (var a in job.Actions)
+					ExternalBotBridge.LookupByPlayer(a.Player)?.ActionWriter.TryWrite(a.Action);
+
+				var watch = Stopwatch.StartNew();
+				var idle = 0;
+				while (world.WorldTick < job.Until)
+				{
+					var before = world.WorldTick;
+					tick();
+					if (world.WorldTick != before)
+						idle = 0;
+					else if (++idle > 200000)
+						throw new InvalidOperationException($"the world is stuck at tick {before}");
+					else
+						Thread.Yield();
+				}
+
+				var reply = new RLProto.StepReply
+				{
+					Tick = world.WorldTick,
+					GameOver = world.IsGameOver,
+					ElapsedUs = watch.ElapsedTicks * 1000000 / Stopwatch.Frequency,
+				};
+				reply.Observations.AddRange(job.Observations);
+				job.Done.TrySetResult(reply);
+			}
+			catch (Exception e)
+			{
+				job.Done.TrySetException(e);
+			}
+			finally
+			{
+				current = null;
+			}
+		}
+
+		/// <summary>Game thread (ExternalBotBridge.Tick): a view made during the current job.</summary>
+		internal static void Collect(string player, RLProto.GameObservation observation)
+		{
+			current?.Observations.Add(new RLProto.PlayerObservation { Player = player, Observation = observation });
+		}
+
+		/// <summary>gRPC thread: queue a job and wait for the game thread to run it.</summary>
+		internal static Task<RLProto.StepReply> Step(RLProto.StepRequest request, CancellationToken ct)
+		{
+			if (ExternalBotBridge.MultiSessionMode)
+				return Task.FromResult(StepSession(request, ct));
+
+			var job = new Job { Until = request.UntilTick };
+			job.Actions.AddRange(request.Actions);
+			ct.Register(() => job.Done.TrySetCanceled());
+			Jobs.Add(job);
+			return job.Done.Task;
+		}
+
+		/// <summary>Multi-session mode: run one session's ticks on this thread.</summary>
+		static RLProto.StepReply StepSession(RLProto.StepRequest request, CancellationToken ct)
+		{
+			RLSessionManager.SessionState state = null;
+			for (var i = 0; i < 1200 && !ct.IsCancellationRequested; i++)
+			{
+				if (RLSessionManager.SessionStates.TryGetValue(request.SessionId, out state))
+					break;
+
+				Thread.Sleep(50);
+			}
+
+			if (state == null)
+				throw new RpcException(new Status(StatusCode.NotFound, $"no session {request.SessionId}"));
+
+			state.TickLock.Wait(ct);
+			try
+			{
+				var w = state.World;
+				var om = state.OrderManager;
+				var bridges = ExternalBotBridge.Sessions.Values.Where(b => b.World == w && b.IsEnabled).ToList();
+				foreach (var bridge in bridges)
+					if (!bridge.AgentConnected)
+						bridge.OnAgentConnected();
+
+				foreach (var a in request.Actions)
+					bridges.FirstOrDefault(b => b.PlayerName == a.Player)?.ActionWriter.TryWrite(a.Action);
+
+				var job = new Job { Until = request.UntilTick };
+				current = job;
+				var watch = Stopwatch.StartNew();
+				var idle = 0;
+				while (w.WorldTick < job.Until)
+				{
+					var before = w.WorldTick;
+					om.LastTickTime.Value = 0;
+					Sync.RunUnsynced(false, w, () =>
+					{
+						om.TickImmediate();
+						return true;
+					});
+
+					if (om.TryTick())
+						w.Tick();
+
+					if (w.WorldTick != before)
+						idle = 0;
+					else if (++idle > 100000)
+						throw new InvalidOperationException($"the world is stuck at tick {before}");
+				}
+
+				var reply = new RLProto.StepReply
+				{
+					Tick = w.WorldTick,
+					GameOver = w.IsGameOver,
+					ElapsedUs = watch.ElapsedTicks * 1000000 / Stopwatch.Frequency,
+				};
+				reply.Observations.AddRange(job.Observations);
+				return reply;
+			}
+			finally
+			{
+				current = null;
+				state.TickLock.Release();
+			}
+		}
+	}
+}
