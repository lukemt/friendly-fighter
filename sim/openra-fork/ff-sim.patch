@@ -1077,6 +1077,11 @@ public static void LoadMap(string launchMap, string launchBots = null)
 			}
 
 			orders.Add(Order.Command("option gamespeed default"));
+
+			// friendly-fighter sim: OPENRA_LOBBY_OPTIONS="startingcash=5000;crates=True;..." sets lobby options
