diff --git a/OpenRA.Game/Game.cs b/OpenRA.Game/Game.cs
index 18413ce..9ec6de4 100644
--- a/OpenRA.Game/Game.cs
+++ b/OpenRA.Game/Game.cs
@@ -47,6 +47,11 @@ public static class Game
 		/// <summary>True when running with the Null platform (no GPU/rendering).</summary>
 		public static bool IsHeadless => Settings?.Game?.Platform == "Null";
 
+		/// <summary>friendly-fighter sim: virtual time. When set (headless only), the game loop stops pacing
+		/// logic ticks by the wall clock and hands control to this driver instead; the driver runs as many
+		/// ticks as it wants by calling the given action (one logic tick each) and returns.</summary>
+		public static Action<Action> LockstepDriver;
+
 		static WorldRenderer worldRenderer;
 		static string modLaunchWrapper;
 
@@ -835,6 +840,21 @@ static void Loop()
 
 			while (state == RunStatus.Running)
 			{
+				// friendly-fighter sim: virtual time — ticks run only when the lockstep driver asks for them.
+				if (IsHeadless && LockstepDriver != null && OrderManager.World != null)
+				{
+					LockstepDriver(() =>
+					{
+						OrderManager.LastTickTime.Value = 0;
+						LogicTick();
+					});
+					nextLogic = RunTime;
+					nextRender = RunTime;
+					forcedNextRender = RunTime;
+					renderBeforeNextTick = false;
+					continue;
+				}
+
 				// Headless fast-forward: bypass timing/render system entirely.
 				// Runs logic ticks in a tight loop with no sleep or render interleave.
 				// ExternalBotBridge sets tickScale < 1.0 during advance(), which makes
@@ -1077,6 +1097,11 @@ public static void LoadMap(string launchMap, string launchBots = null)
 			}
 
 			orders.Add(Order.Command("option gamespeed default"));
+
+			// friendly-fighter sim: OPENRA_LOBBY_OPTIONS="startingcash=5000;crates=True;..." sets lobby options
+			foreach (var opt in (Environment.GetEnvironmentVariable("OPENRA_LOBBY_OPTIONS") ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries))
+				orders.Add(Order.Command($"option {opt.Trim().Replace('=', ' ')}"));
+
 			orders.Add(Order.Command($"state {Session.ClientState.Ready}"));
 
 			var map = ModData.MapCache.SingleOrDefault(m => m.Uid == launchMap || Path.GetFileName(m.Path) == launchMap);
